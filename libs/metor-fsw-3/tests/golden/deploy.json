{
  "config_version": 2,
  "hosts": {},
  "targets": [
    {
      "packs": [
        {
          "id": "echo",
          "lib": "echo_pack",
          "libs": "<libs>"
        }
      ],
      "coordinator": {
        "clock": {
          "Wall": {
            "rate": 1000.0
          }
        },
        "ring_depth": 8,
        "seed": 0,
        "namespace": "a",
        "systems": [
          {
            "id": "sampler",
            "ty": "echo.sampler",
            "params": null,
            "inputs": [],
            "outputs": []
          },
          {
            "id": "pub",
            "ty": "fsw.publish",
            "params": {
              "conn_cap": 1048576,
              "link": "pub",
              "namespace": "a",
              "transport": {
                "listen": {
                  "addr": "127.0.0.1:2240",
                  "max_connections": 8
                }
              }
            },
            "inputs": [
              {
                "port": "sampler.sample",
                "from": [
                  {
                    "system": "sampler",
                    "port": "sample"
                  }
                ]
              },
              {
                "port": "sampler.log",
                "from": [
                  {
                    "system": "sampler",
                    "port": "log"
                  }
                ]
              },
              {
                "port": "sampler.status",
                "from": [
                  {
                    "system": "sampler",
                    "port": "status"
                  }
                ]
              }
            ],
            "outputs": []
          }
        ]
      }
    },
    {
      "packs": [
        {
          "id": "echo",
          "lib": "echo_pack",
          "libs": "<libs>"
        }
      ],
      "coordinator": {
        "clock": {
          "Wall": {
            "rate": 1000.0
          }
        },
