{
  "config_version": 1,
  "packs": [
    {
      "id": "adcs",
      "lib": "adcs_systems",
      "libs": "/abs/.metor/adcs_pack/_libs"
    }
  ],
  "coordinator": {
    "clock": {
      "Wall": {
        "rate": 100.0
      }
    },
    "ring_depth": 8,
    "systems": [
      {
        "id": "cmds",
        "ty": "fsw.subscribe",
        "params": {
          "transport": {
            "listen": {
              "addr": "127.0.0.1:0",
              "max_connections": 8
            }
          },
          "namespace": "cube_sat",
          "link": "cmds",
          "pending_cap": 1048576,
          "inbound_cap": 256
        },
        "inputs": [],
        "outputs": [
          {
            "port": "ping",
            "record": "ping"
          }
        ]
      },
      {
        "id": "plant",
        "ty": "adcs.plant",
        "params": {
          "altitude": 400000.0
        },
        "inputs": [
          {
            "port": "motor_cmd",
            "from": [
              {
                "system": "ctrl",
                "port": "motor_cmd"
              }
            ]
          }
        ]
      },
      {
        "id": "nav",
        "ty": "adcs.nav",
        "params": {
          "gain": 0.2
        },
        "inputs": [
          {
            "port": "imu",
            "from": [
              {
                "system": "plant",
                "port": "imu"
              }
            ]
          }
        ]
      },
      {
        "id": "mode",
        "ty": "adcs.mode",
        "params": null,
        "inputs": []
      },
      {
        "id": "ctrl",
        "ty": "adcs.ctrl",
        "params": null,
        "inputs": [
          {
            "port": "est",
            "from": [
              {
                "system": "nav",
                "port": "est"
              }
            ]
          },
          {
            "port": "mode",
            "from": [
              {
                "system": "mode",
                "port": "cmd"
              }
            ]
          }
        ]
      },
      {
        "id": "pub",
        "ty": "fsw.publish",
        "params": {
          "transport": {
            "listen": {
              "addr": "127.0.0.1:0",
              "max_connections": 8
            }
          },
          "namespace": "cube_sat",
          "link": "pub",
          "pending_cap": 1048576
        },
        "thread": "io",
        "inputs": [
          {
            "port": "plant.imu",
            "from": [
              {
                "system": "plant",
                "port": "imu"
              }
            ]
          },
          {
            "port": "plant.log",
            "from": [
              {
                "system": "plant",
                "port": "log"
              }
            ]
          },
          {
            "port": "plant.status",
            "from": [
              {
                "system": "plant",
                "port": "status"
              }
            ]
          },
          {
            "port": "nav.est",
            "from": [
              {
                "system": "nav",
                "port": "est"
              }
            ]
          }
        ]
      }
    ]
  }
}
