coordinator cycle_rate=120.0 sim_dt=0.008333333333333333

artifact "plant" crate="adcs-plant" lib="adcs_plant" type="Plant"
artifact "nav"   crate="adcs-nav"   lib="adcs_nav"   type="Nav"
artifact "ctrl"  crate="adcs-ctrl"  lib="adcs_ctrl"  type="Ctrl"

// sequences
artifact "commissioning" crate="adcs-commissioning" lib="adcs_commissioning" type="commissioning"
artifact "safe_mode"     crate="adcs-safe-mode"     lib="adcs_safe_mode"     type="safe_mode"

// systems
system "plant" type="Plant" artifact="plant" init_angle=0.5 init_rate=0.15 meas_sigma=0.002 seed=42 disarmed=#false
system "nav"   type="Nav"   artifact="nav"   meas_sigma=0.02
system "ctrl"  type="Ctrl"  artifact="ctrl"  q_weight=5.0 r_weight=8.0

system "alarms" type="Alarms" {
    alarm id="ADCS_RATE_HIGH" name="Body Rate High" {
        description "Measured body-Y rate exceeds the detumbled envelope"
        target component="plant.sensors.gyro_b" element=1
        warning above=0.05 below=-0.05
        critical above=0.15 below=-0.15
        debounce 2
        hysteresis 0.005
    }
}

slot "slot" {
    input  frame="attitude_estimate"
    output frame="mode_cmd"
    allow occupant="commissioning"
    allow occupant="safe_mode"
    initial occupant="commissioning" state="running"
}

connect "plant" -> "nav"  frame="sensors"
connect "plant" -> "nav"  frame="gps"
connect "plant" -> "ctrl" frame="gps"
connect "nav"   -> "ctrl" frame="attitude_estimate"
connect "nav"   -> "slot" frame="attitude_estimate"

connect "slot"  -> "ctrl" frame="mode_cmd" delayed=#true
connect "ctrl"  -> "plant" frame="torque_cmd" delayed=#true

system "uplink" type="TcpUplink" addr="127.0.0.1:2240" {
    msgs "SequenceCommand" "AlarmAck"
}

system "downlink" type="TcpDownlink" addr="127.0.0.1:2240"

connect "uplink"      -> "slot" msg="SequenceCommand"   // ground commands
connect "coordinator" -> "slot" msg="SequenceCommand"   // in-proc control_handle
connect "uplink"      -> "alarms" msg="AlarmAck"        // operator acks (gate latching alarms)
