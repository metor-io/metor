coordinator cycle_rate=120.0 sim_dt=0.008333333333333333

artifact "plant" crate="adcs-plant" lib="adcs_plant" type="Plant"
artifact "nav"   crate="adcs-nav"   lib="adcs_nav"   type="Nav"
artifact "ctrl"  crate="adcs-ctrl"  lib="adcs_ctrl"  type="Ctrl"

// sequences
artifact "commissioning" crate="adcs-commissioning" lib="adcs_commissioning" type="commissioning"
artifact "safe_mode"     crate="adcs-safe-mode"     lib="adcs_safe_mode"     type="safe_mode"

// systems
// The plant's disturbance/actuator environment is spelled out in full (the dlopen param
// encoder fills the exported schema from this node — `#[serde(default)]` is a static-link
// nicety only). Physically honest values for a ~3 kg spacecraft at 400 km: secular torques
// ~1e-7 N·m, so wheel momentum builds over days — crank `m_res_b`/`init_wheel_h` to watch
// desaturation work in seconds.
system "plant" type="Plant" artifact="plant" init_angle=0.5 init_rate=0.15 meas_sigma=0.002 seed=42 disarmed=#false process=#true {
    rho 3e-12                   // atmospheric density (kg/m³, 400 km solar-mean)
    cd 2.2                      // drag coefficient
    area_aero 0.03              // aero reference area (m²)
    cp_offset_b 0.02 0.0 0.0    // CP–CG offset (m) — the drag/SRP torque arm
    m_res_b 0.002 0.002 0.002   // residual magnetic dipole (A·m²)
    area_srp 0.03               // SRP reference area (m²)
    cr 1.5                      // SRP reflectivity coefficient
    mtq_max_dipole 0.2          // per-axis magnetorquer authority (A·m²)
    init_wheel_h 0.0            // per-wheel stored-momentum preload (N·m·s)
    init_orbit_phase 0.0        // in-plane boot phase (rad) — eclipse tests start in shadow
}
system "nav"   type="Nav"   artifact="nav"   meas_sigma=0.02
system "ctrl"  type="Ctrl"  artifact="ctrl"  q_weight=5.0 r_weight=8.0 k_desat=0.0005 k_detumble=0.00005

system "alarms" type="Alarms" {
    alarm id="ADCS_RATE_HIGH" name="Body Rate High" {
        description "Measured body-Y rate exceeds the detumbled envelope"
        target component="plant.sensors.gyro_b" element=1
        warning above=0.05 below=-0.05
        critical above=0.15 below=-0.15
        debounce 2
        hysteresis 0.005
    }
    alarm id="RW_MOMENTUM_HIGH" name="Wheel Momentum High" {
        description "Wheel-0 stored momentum approaching the saturation limit"
        // The doubled `wheels` is instance + frame-field nesting: instance `plant`, frame
        // `wheels`, field `wheels: [ReactionWheel; 3]`, wheel 0, its X-axis momentum element.
        target component="plant.wheels.wheels.0.ang_momentum" element=0
        warning above=0.03 below=-0.03
        critical above=0.038 below=-0.038
        debounce 2
        hysteresis 0.001
    }
}

slot "mode" {
    input  frame="attitude_estimate"
    input  frame="gps"              // commissioning's tracking-error gate
    output frame="mode_cmd"
    // The commissioning gates/budgets ride the allow line (sequence params — spelled out in
    // full, the dlopen occupant encoder has no serde defaults). Detumble enters only above
    // 1.0 rad/s: capturing that tumble loads the worst wheel axis to ~38% of the momentum
    // limit, so anything slower goes straight to the wheels.
    allow occupant="commissioning" rate_detumble_enter=1.0 rate_detumble_exit=0.8 \
          est_delta_rad=0.001 est_dwell_s=0.2 coarse_err_rad=0.2 coarse_dwell_s=0.5 \
          confirm_dwell_s=1.0 warmup_timeout_s=10.0 detumble_timeout_s=900.0 \
          settle_timeout_s=60.0 confirm_timeout_s=30.0
    allow occupant="safe_mode"
    initial occupant="commissioning" state="running"
}

connect "plant" -> "nav"  frame="sensors"
connect "plant" -> "nav"  frame="gps"
connect "plant" -> "ctrl" frame="gps"
connect "plant" -> "ctrl" frame="sensors"   // measured B for the magnetorquer laws
connect "plant" -> "ctrl" frame="wheels"    // telemetered wheel momentum for desat
connect "nav"   -> "ctrl" frame="attitude_estimate"
connect "nav"   -> "mode" frame="attitude_estimate"
connect "plant" -> "mode" frame="gps"

connect "mode"  -> "ctrl" frame="mode_cmd" delayed=#true
connect "ctrl"  -> "plant" frame="torque_cmd" delayed=#true
connect "ctrl"  -> "plant" frame="mtq_cmd" delayed=#true

system "uplink" type="TcpUplink" addr="127.0.0.1:2240" {
    msgs "SequenceCommand" "AlarmAck"
}

system "downlink" type="TcpDownlink" addr="127.0.0.1:2240"

connect "uplink"      -> "mode" msg="SequenceCommand"   // ground commands
connect "coordinator" -> "mode" msg="SequenceCommand"   // in-proc control_handle
connect "uplink"      -> "alarms" msg="AlarmAck"        // operator acks (gate latching alarms)
